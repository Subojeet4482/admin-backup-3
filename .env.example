# ---------- LOGIN (teeno services mein SAME rakho) ----------
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_PIN=
SESSION_SECRET=              # lamba random string (Render Blueprint khud bana deta hai)
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=60

# ---------- FIREBASE ----------
# python tools/make_b64.py serviceAccount.json  -> output yahan paste
FIREBASE_CREDENTIALS_B64=

# ---------- CHAT DATABASE (optional; Data Center chat types ke liye) ----------
FIREBASE_CREDENTIALS_B641=

# ---------- BACKUP ----------
BACKUP_DIR=                  # khali = ./backups (Render free par restart par saaf). Paid Disk ho to /var/data/backups
BACKUP_INTERVAL_HOURS=24     # panel se bhi badal sakte ho
BACKUP_KEEP=10
AUTO_BACKUP_TELEGRAM=true    # auto-backup ki copy Telegram par bhi
MAX_UPLOAD_MB=100

# ---------- DELAY / SPEED (panel -> Home -> Delay/Speed se bhi badalta hai) ----------
SLOW_FACTOR=1                # 0.3 turbo | 1 normal | 2 slow | 4 ultra
BACKUP_PACE_EVERY=200
BACKUP_PACE_REST=0.5
DC_TZ_OFFSET_MIN=330         # IST

# ---------- RENDER STATUS / UPTIMEROBOT / SELF REVIVE ----------
# Teeno panels ke URL (teeno services mein same daalo) — header ke switcher aur "Wake" button ke liye
PANEL_MAIN_URL=https://ff-main.onrender.com
PANEL_PAYMENT_URL=https://ff-payment.onrender.com
PANEL_BACKUP_URL=https://ff-backup.onrender.com

# UptimeRobot: My Settings -> API -> "Read-only API key" (status panel mein dikhane ke liye). Monitor URL = <service-url>/health
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_MONITOR=         # optional: monitor ka naam/id (URL se auto-match na ho to)

# Render API (optional): deploy status + ek-tap Restart. Dashboard -> Account Settings -> API Keys; Service ID = srv-xxxx (service URL mein)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Self-ping (khud ko har 10 min ping, free plan idle-sleep se bachne ke liye). RENDER_EXTERNAL_URL Render khud deta hai.
KEEPALIVE=false  # backup service ko sone do (hours bachao); monthly backup jaagte hi catch-up ho jata hai
KEEPALIVE_INTERVAL=600
KEEPALIVE_URL=               # sirf Docker/local mein (Render par zaroorat nahi)
KEEPALIVE_SIBLINGS=false     # true = ye service doosre panels ko bhi ping kare (unko jagaye rakhta hai — free hours kharch hote hain!)
